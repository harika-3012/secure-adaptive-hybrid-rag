# Copy to .env and adjust. No secrets are required: everything runs locally.
DATA_DIR=../data
CHROMA_DIR=../data/processed/chroma
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Optional: path to a locally downloaded copy of the model (air-gapped use)
EMBEDDING_MODEL_PATH=
CHUNK_SIZE=800
CHUNK_OVERLAP=120
MAX_UPLOAD_MB=25
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_S=180
FIXED_ALPHA=0.5
MIN_EVIDENCE_SCORE=0.25
CORS_ORIGINS=http://localhost:5173
