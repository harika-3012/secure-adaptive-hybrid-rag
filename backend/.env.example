# Copy to .env (setup.bat does this) and adjust. Everything runs locally; no cloud services are used.
DATA_DIR=../data
CHROMA_DIR=../data/processed/chroma
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Optional: path to a locally downloaded copy of the model (air-gapped use)
EMBEDDING_MODEL_PATH=
CHUNK_SIZE=800
CHUNK_OVERLAP=120
MAX_UPLOAD_MB=25
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_S=180
FIXED_ALPHA=0.5
MIN_EVIDENCE_SCORE=0.25
CORS_ORIGINS=http://localhost:5173

# MongoDB holds users, document metadata, chunks, conversations and audit logs.
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=sahrag
# Signs login tokens. Generated automatically by scripts\setup.bat (or: python scripts\init_env.py).
JWT_SECRET=
JWT_EXPIRE_MINUTES=480
# The first account created becomes the administrator. Set to false to allow only admin-created accounts afterwards.
ALLOW_SELF_REGISTRATION=true
